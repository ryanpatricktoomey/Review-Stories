// PROPOSED rules only. Do not deploy until reviewed.
// Keep existing Word Bank and chat permissions intact.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.uid == 'VWok43w84cbFLVdn7zB9NeTTVbG2'; }
    function validClass(t) { return t in ['06:30','07:15','08:45','09:30','10:20','12:00']; }
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    match /chats/{chatId}/messages/{messageId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }
    match /publicProfiles/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname','classTime','emoji'])
        && request.resource.data.keys().hasAll(['nickname','classTime'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 30
        && validClass(request.resource.data.classTime)
        && (!('emoji' in request.resource.data) || (request.resource.data.emoji is string && request.resource.data.emoji in ["😀","😎","🥳","😂","😊","😇","🤩","😍","🤓","😴","😺","🐱","🐶","🐻","🐼","🐰","🦊","🐸","🐯","🦁","🐨","🐧","🐢","🐝","🦋","🐳","🐙","🦄","🌸","🌻","🌷","🌹","🌈","⭐","🌙","☀️","🔥","💎","💖","🍀","🍎","🍓","🍑","🍒","🍋","🍕","🍩","🍪","☕","🍵","🎨","🎵","🎸","🎮","⚽","🏀","🚀","✈️","📚","💡"]));
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /notifications/{recipientUid}/items/{notificationId} {
      allow read: if signedIn() && request.auth.uid == recipientUid;
      allow update: if signedIn() && request.auth.uid == recipientUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if signedIn() && request.auth.uid == recipientUid;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['activityId','responseUid','replyId','sourceReplyId','senderUid','nickname','emoji','text','read','createdAt','collectionName'])
        && request.resource.data.keys().hasOnly(['activityId','responseUid','replyId','sourceReplyId','senderUid','nickname','emoji','text','read','createdAt','collectionName'])
        && request.resource.data.replyId == notificationId
        && request.resource.data.senderUid == request.auth.uid
        && recipientUid != request.auth.uid
        && request.resource.data.collectionName in ['responses','comments']
        && request.resource.data.activityId is string
        && request.resource.data.responseUid is string
        && request.resource.data.sourceReplyId is string
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.nickname == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.nickname
        && request.resource.data.emoji is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && getAfter(/databases/$(database)/documents/activities/$(request.resource.data.activityId)/$(request.resource.data.collectionName)/$(request.resource.data.responseUid)/replies/$(notificationId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/activities/$(request.resource.data.activityId)/$(request.resource.data.collectionName)/$(request.resource.data.responseUid)/replies/$(notificationId)).data.text == request.resource.data.text
        && ( (request.resource.data.sourceReplyId == 'owner' && getAfter(/databases/$(database)/documents/activities/$(request.resource.data.activityId)/$(request.resource.data.collectionName)/$(request.resource.data.responseUid)).data.uid == recipientUid)
          || (request.resource.data.sourceReplyId != 'owner'
            && get(/databases/$(database)/documents/activities/$(request.resource.data.activityId)/$(request.resource.data.collectionName)/$(request.resource.data.responseUid)/replies/$(request.resource.data.sourceReplyId)).data.uid == recipientUid));
    }
    match /activities/{activityId} {
      allow read: if resource.data.published == true || admin();
      allow create, update, delete: if admin();
      match /{collectionName}/{responseId} {
        allow read: if collectionName in ['responses','comments'] && (get(/databases/$(database)/documents/activities/$(activityId)).data.published == true || admin());
        allow create, update: if collectionName in ['responses','comments'] && signedIn()
          && get(/databases/$(database)/documents/activities/$(activityId)).data.published == true
          && ((collectionName == 'responses' && get(/databases/$(database)/documents/activities/$(activityId)).data.type in ['poll','quiz'] && responseId == request.auth.uid)
            || ((collectionName == 'comments' && get(/databases/$(database)/documents/activities/$(activityId)).data.type in ['poll','quiz'] || collectionName == 'responses' && !(get(/databases/$(database)/documents/activities/$(activityId)).data.type in ['poll','quiz'])) && request.method == 'create'))
          && request.resource.data.keys().hasOnly(['uid','text','nickname','classTime','emoji','updatedAt'])
          && request.resource.data.keys().hasAll(['uid','text','nickname','classTime','updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500
          && request.resource.data.nickname == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.nickname
          && request.resource.data.classTime == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.classTime
          && (!('emoji' in request.resource.data) || request.resource.data.emoji == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.get('emoji','😊'))
          && request.resource.data.updatedAt == request.time;
        allow delete: if collectionName in ['responses','comments'] && (admin() || (signedIn() && request.auth.uid == resource.data.uid));
        match /replies/{replyId} {
          allow read: if collectionName in ['responses','comments'] && (get(/databases/$(database)/documents/activities/$(activityId)).data.published == true || admin());
          allow create: if collectionName in ['responses','comments'] && signedIn()
            && get(/databases/$(database)/documents/activities/$(activityId)).data.published == true
            && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
            && request.resource.data.keys().hasOnly(['uid','text','nickname','classTime','emoji','createdAt'])
            && request.resource.data.keys().hasAll(['uid','text','nickname','classTime','createdAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 500
            && request.resource.data.nickname == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.nickname
            && request.resource.data.classTime == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.classTime
            && (!('emoji' in request.resource.data) || request.resource.data.emoji == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.get('emoji','😊'))
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if collectionName in ['responses','comments'] && (admin() || (signedIn() && request.auth.uid == resource.data.uid));
        }
      }
    }
  }
}